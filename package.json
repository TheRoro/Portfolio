{
  "name": "portfolio",
  "type": "module",
  "private": false,
  "description": "Software Engineer Portfolio",
  "version": "2.0.0",
  "license": "0BSD",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build && node scripts/generate-route-pages.mjs",
    "dev": "vite",
    "local": "vite --host 0.0.0.0",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "vite",
    "serve": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "check": "npm run format:check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheRoro/Portfolio"
  },
  "bugs": {
    "url": "https://github.com/TheRoro/Portfolio/issues"
  },
  "dependencies": {
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intersection-observer": "^11.0.0",
    "react-router-dom": "^7.18.2",
    "react-scroll": "^1.9.3",
    "sass": "^1.102.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0"
  }
}
